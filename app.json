{
  "expo": {
    "name": "Iskan Nrxiakan",
    "slug": "iskannrxakan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nrxiskan_4k.png",
    "scheme": "iskannrxakan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/nrxiskan_4k.png",
      "bundleIdentifier": "com.trxstudio.iskannrxakan"
    },
    "android": {
      "package": "com.trxstudio.iskannrxakan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nrxiskan_4k.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nrxiskan_4k.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1E3A",
          "image": "./assets/images/nrxiskan_4k.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a20906c-c588-4701-b647-7b5c1ea504fd"
      }
    }
  }
}