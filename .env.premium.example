# Copy these settings into .env locally and the EAS production environment.
# Leave the SDK key empty until you have configured the Apple app in RevenueCat.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=premium
EXPO_PUBLIC_PREMIUM_PRODUCT_ID=com.trxstudio.iskannrxakan.premium.monthly
# Empty uses RevenueCat's current offering.
EXPO_PUBLIC_PREMIUM_OFFERING_ID=
