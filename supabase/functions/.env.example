# Copy to .env in this directory, fill locally, then upload with Supabase secrets.
# These are SERVER secrets. Never use EXPO_PUBLIC_ for these values.
REVENUECAT_SECRET_API_KEY=
# Use an independently generated random Authorization value (at least 32 chars).
# The complete value must match the webhook's Authorization setting in RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_PRODUCT_ID=com.trxstudio.iskannrxakan.premium.monthly
